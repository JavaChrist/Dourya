# DOURYA : modèle des variables d'environnement.
# Copier en .env.local et remplir avec les vraies valeurs (jamais commitées).
# En production, les valeurs vont dans les variables d'environnement Vercel.
# Aucune variable n'est utilisée au lot 1.

# --- Public (exposé au navigateur) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secret, serveur uniquement (jamais NEXT_PUBLIC_) ---
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
MOLLIE_API_KEY=test_replace_me
