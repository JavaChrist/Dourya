# DOURYA : modèle des variables d'environnement.
# Copier en .env.local et remplir avec les vraies valeurs (jamais commitées).
# En production, les valeurs vont dans les variables d'environnement Vercel.
# Ce fichier ne contient QUE des valeurs fictives. Lues depuis le lot 3 : NEXT_PUBLIC_FIREBASE_* et FIREBASE_ADMIN_*. Stripe : lot 4.

# --- Public (exposé au navigateur) ---
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_ME
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_ME
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secret, serveur uniquement (jamais NEXT_PUBLIC_) ---
FIREBASE_ADMIN_PROJECT_ID=REPLACE_ME
FIREBASE_ADMIN_CLIENT_EMAIL=REPLACE_ME
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME

# --- Optionnel : seulement si l'intégration Stripe retenue l'exige (inutile avec Checkout hébergé) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_ME
