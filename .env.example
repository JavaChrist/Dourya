# DOURYA : modèle des variables d'environnement.
# Copier en .env.local et remplir avec les vraies valeurs (jamais commitées).
# En production, les valeurs vont dans les variables d'environnement Vercel.
# Ce fichier ne contient QUE des valeurs fictives. Lues : NEXT_PUBLIC_FIREBASE_*, FIREBASE_ADMIN_*, NEXT_PUBLIC_SITE_URL et EMAIL_* / RESEND_*. Stripe : lot 4.

# --- Public (exposé au navigateur) ---
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_ME
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_ME
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_ME
# URL publique du site (canonical, sitemap, robots, liens des e-mails). Production : https://dourya.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secret, serveur uniquement (jamais NEXT_PUBLIC_) ---
FIREBASE_ADMIN_PROJECT_ID=REPLACE_ME
FIREBASE_ADMIN_CLIENT_EMAIL=REPLACE_ME
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME

# --- E-mails DOURYA (serveur uniquement, lot 3 bis) ---
# firebase (défaut) : e-mails Firebase inchangés. test : rendus en mémoire, jamais envoyés.
# resend : envoi réel. A activer UNIQUEMENT quand le domaine d'envoi est vérifié dans Resend.
EMAIL_TRANSPORT=firebase
RESEND_API_KEY=REPLACE_ME
RESEND_WEBHOOK_SECRET=REPLACE_ME
# Obligatoires avec resend (aucune valeur par défaut, rien n'est envoyé s'il en manque une).
EMAIL_FROM=REPLACE_ME
# Format attendu : "DOURYA <adresse@domaine-verifie>"
EMAIL_REPLY_TO=REPLACE_ME
EMAIL_LEGAL_NAME=REPLACE_ME
EMAIL_LEGAL_ADDRESS=REPLACE_ME
# Optionnel (ex. numéro SIRET).
EMAIL_LEGAL_REGISTRATION=
# Au moins 32 caractères aléatoires (liens de désinscription newsletter).
EMAIL_UNSUBSCRIBE_SECRET=REPLACE_ME

# --- Optionnel : seulement si l'intégration Stripe retenue l'exige (inutile avec Checkout hébergé) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_ME
