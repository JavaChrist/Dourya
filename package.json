{
  "name": "dourya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "node scripts/emulators.mjs --ui \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project unit",
    "test:integration": "node scripts/emulators.mjs \"vitest run --project integration\"",
    "test:stripe-real": "node scripts/emulators.mjs \"vitest run --project integration tests/checkout/stripe-real\"",
    "typecheck": "tsc --noEmit",
    "email:preview": "email dev --dir src/emails --port 3030",
    "email:test": "node scripts/email-send-test.mjs",
    "admin:role": "node --env-file-if-exists=.env.local scripts/admin-role.mjs",
    "seed:test": "node --env-file-if-exists=.env.local scripts/seed-dourya-test.mjs",
    "catalog:import": "node --env-file-if-exists=.env.local --import ./scripts/ts-hooks.mjs scripts/catalog-import-test.mjs"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "react-email": "^6.11.16",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4",
    "@grpc/grpc-js": "^1.14.7"
  },
  "engines": {
    "node": "24.x"
  }
}
