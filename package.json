{
  "name": "dourya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "node scripts/emulators.mjs --ui \"next dev\"",
    "build": "next build",
    "start": "next start",
