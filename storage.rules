rules_version = '2';

// DOURYA: product images are public (read only). Nothing else is readable,
// and no client may upload: files are added by the server or the console.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
