rules_version = '2';

// DOURYA: product images are public (read only). Nothing else is readable,
// and no client may upload: files are added by the server or the console.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Draft photos of the catalogue admin (dourya.fr and the stripe-test preview): written and
    // read by the server only (Admin SDK), served to admins by
    // /admin/catalogue/photos/**. Never public.
    match /catalog-drafts/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
